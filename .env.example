# Web application and Supabase (required for the web app)
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy alternative to NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=******host:5432/database
DIRECT_URL=******host:5432/database

# GitHub OAuth credentials are configured in the Supabase dashboard, not this app.
# Optional values for Supabase GitHub provider setup:
GITHUB_CLIENT_ID=your-client-id
GITHUB_CLIENT_SECRET=your-client-secret
# GitHub App (required for repository import)
GITHUB_APP_ID=your-app-id
GITHUB_APP_SLUG=your-github-app-slug
# Optional override; must be an https://github.com installation URL:
# GITHUB_APP_INSTALL_URL=https://github.com/apps/your-github-app-slug/installations/select_target
GITHUB_APP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----
GITHUB_APP_WEBHOOK_SECRET=replace-with-random-secret
GITHUB_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Scanning / AI backend
AI_BACKEND_URL=http://127.0.0.1:8000
AI_CALLBACK_SECRET=replace-with-random-secret
GOOGLE_GEMINI_API_KEY=your-gemini-key

# MCP API-key encryption (required to create/use MCP keys)
MCP_API_KEY_SECRET=replace-with-32-byte-base64-key

# Optional billing (only needed when enabling Stripe routes)
STRIPE_SECRET_KEY=your-stripe-secret
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Local stdio MCP process (set in the MCP client, not the hosted web app)
CONTEXT_COMPILER_BASE_URL=http://localhost:3000
CONTEXT_COMPILER_MCP_KEY=ccmcp_replace_with_repository_key
CONTEXT_COMPILER_TIMEOUT_MS=15000
