generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionTier {
  FREE
  PRO
  TEAM
  ENTERPRISE
}

enum WorkspaceType {
  PERSONAL
  TEAM
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

enum NotificationType {
  WORKSPACE_INVITE
}

enum RepositoryScanStatus {
  IDLE
  QUEUED
  SCANNING
  COMPLETED
  FAILED
}

enum ScanJobStatus {
  QUEUED
  SCANNING
  COMPLETED
  FAILED
}

enum AnswerSessionStatus {
  SAVED
  ARCHIVED
}

model User {
  id                   String           @id @db.Uuid
  email                String           @unique
  name                 String?
  avatarUrl            String?
  githubId             String?          @unique
  githubTokenEncrypted String?
  githubTokenUpdatedAt DateTime?
  isPlatformAdmin      Boolean          @default(false)
  stripeCustomerId     String?          @unique
  subscriptionTier     SubscriptionTier @default(FREE)
  repositories         Repository[]
  savedCarts           SavedCart[]
  answerSessions       AnswerSession[]
  ownedWorkspaces      Workspace[]      @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  sentWorkspaceInvites WorkspaceInvite[] @relation("WorkspaceInviteSender")
  notifications        Notification[]
  auditLogs            AuditLog[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

model Workspace {
  id                   String             @id @default(uuid()) @db.Uuid
  name                 String
  slug                 String             @unique
  type                 WorkspaceType
  subscriptionTier     SubscriptionTier   @default(FREE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  seatLimit            Int?
  ownerUserId          String             @db.Uuid
  owner                User               @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members              WorkspaceMember[]
  invites              WorkspaceInvite[]
  notifications        Notification[]
  repositories         Repository[]
  savedCarts           SavedCart[]
  answerSessions       AnswerSession[]
  auditLogs            AuditLog[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([ownerUserId])
  @@index([subscriptionTier])
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole
  joinedAt    DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
}

model WorkspaceInvite {
  id              String                @id @default(uuid()) @db.Uuid
  workspaceId     String                @db.Uuid
  email           String
  role            WorkspaceRole
  status          WorkspaceInviteStatus @default(PENDING)
  invitedByUserId String                @db.Uuid
  workspace       Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy       User                  @relation("WorkspaceInviteSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  notifications   Notification[]
  createdAt       DateTime              @default(now())
  respondedAt     DateTime?

  @@index([email, status])
  @@index([workspaceId, status])
}

model Notification {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @db.Uuid
  workspaceId       String?           @db.Uuid
  type              NotificationType
  title             String
  body              String            @db.Text
  readAt            DateTime?
  workspaceInviteId String?           @db.Uuid
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace         Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  workspaceInvite   WorkspaceInvite?  @relation(fields: [workspaceInviteId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())

  @@index([userId, readAt, createdAt])
  @@index([workspaceInviteId])
}

model AuditLog {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String?    @db.Uuid
  actorUserId String?    @db.Uuid
  eventType   String
  entityType  String
  entityId    String?
  metadata    Json?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actor       User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([workspaceId, createdAt])
  @@index([actorUserId, createdAt])
}

model Repository {
  id                   String               @id @default(uuid()) @db.Uuid
  userId               String               @db.Uuid
  workspaceId          String?              @db.Uuid
  githubRepoId         String?
  indexFormatVersion   Int                  @default(1)
  name                 String
  fullName             String
  owner                String?
  githubUrl            String
  defaultBranch        String?
  isPrivate            Boolean              @default(true)
  lastScannedAt        DateTime?
  lastIndexedCommitSha String?
  scanStatus           RepositoryScanStatus @default(IDLE)
  scanProgress         Int                  @default(0)
  filesDiscovered      Int                  @default(0)
  filesProcessed       Int                  @default(0)
  errorMessage         String?
  activeScanJobId      String?              @db.Uuid
  codeDocuments        CodeDocument[]
  scanJobs             ScanJob[]
  savedCarts           SavedCart[]
  answerSessions       AnswerSession[]
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace            Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([workspaceId, githubUrl])
  @@unique([workspaceId, githubRepoId])
  @@index([userId])
  @@index([workspaceId])
  @@index([workspaceId, scanStatus])
  @@index([workspaceId, githubRepoId])
  @@index([lastScannedAt])
}

model CodeDocument {
  id                  String     @id @default(uuid()) @db.Uuid
  repositoryId        String     @db.Uuid
  lastSeenScanJobId   String?    @db.Uuid
  filePath            String
  chunkIndex          Int        @default(0)
  language            String?
  fileCategory        String?
  chunkType           String?
  pathBucket          String?
  content             String     @db.Text
  contentHash         String
  tokenCount          Int        @default(0)
  embedding           Unsupported("vector(768)")?
  embeddingModel      String?
  embeddingDimensions Int?
  metadata            Json?
  repository          Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@unique([repositoryId, filePath, chunkIndex])
  @@index([repositoryId, filePath])
  @@index([repositoryId, contentHash])
  @@index([repositoryId, language])
  @@index([repositoryId, fileCategory])
  @@index([repositoryId, pathBucket])
  @@index([repositoryId, lastSeenScanJobId])
  @@index([embedding], map: "idx_code_documents_embedding")
}

model ScanJob {
  id                String        @id @default(uuid()) @db.Uuid
  repositoryId      String        @db.Uuid
  triggeredByUserId String        @db.Uuid
  status            ScanJobStatus @default(QUEUED)
  indexedCommitSha  String?
  filesDiscovered   Int           @default(0)
  filesProcessed    Int           @default(0)
  errorMessage      String?
  startedAt         DateTime?
  lastHeartbeatAt   DateTime?
  completedAt       DateTime?
  repository        Repository    @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([repositoryId, createdAt])
  @@index([repositoryId, status])
  @@index([repositoryId, lastHeartbeatAt])
  @@index([triggeredByUserId])
}

model SavedCart {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @db.Uuid
  workspaceId  String?         @db.Uuid
  repositoryId String          @db.Uuid
  title        String
  description  String?
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository   Repository      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  items        SavedCartItem[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId, repositoryId, updatedAt])
  @@index([workspaceId, repositoryId, updatedAt])
  @@index([repositoryId, updatedAt])
}

model SavedCartItem {
  id              String     @id @default(uuid()) @db.Uuid
  savedCartId      String     @db.Uuid
  codeDocumentId   String?    @db.Uuid
  filePath         String
  chunkIndex       Int
  language         String?
  contentSnapshot  String     @db.Text
  score            Float?
  orderIndex       Int
  savedCart        SavedCart  @relation(fields: [savedCartId], references: [id], onDelete: Cascade)
  createdAt        DateTime   @default(now())

  @@index([savedCartId, orderIndex])
  @@index([codeDocumentId])
}

model AnswerSession {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @db.Uuid
  workspaceId  String?             @db.Uuid
  repositoryId String              @db.Uuid
  question     String              @db.Text
  answer       String              @db.Text
  status       AnswerSessionStatus @default(SAVED)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository   Repository          @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  citations    AnswerCitation[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([userId, repositoryId, updatedAt])
  @@index([workspaceId, repositoryId, updatedAt])
  @@index([repositoryId, updatedAt])
}

model AnswerCitation {
  id             String        @id @default(uuid()) @db.Uuid
  answerSessionId String        @db.Uuid
  codeDocumentId  String?       @db.Uuid
  filePath        String
  chunkIndex      Int
  language        String?
  contentSnapshot String        @db.Text
  score           Float?
  orderIndex      Int
  answerSession   AnswerSession @relation(fields: [answerSessionId], references: [id], onDelete: Cascade)

  @@index([answerSessionId, orderIndex])
  @@index([codeDocumentId])
}
