generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionTier {
  FREE
  PRO
  TEAM
  ENTERPRISE
}

enum RepositoryScanStatus {
  IDLE
  QUEUED
  SCANNING
  COMPLETED
  FAILED
}

enum ScanJobStatus {
  QUEUED
  SCANNING
  COMPLETED
  FAILED
}

enum AnswerSessionStatus {
  SAVED
  ARCHIVED
}

model User {
  id                   String           @id @db.Uuid
  email                String           @unique
  name                 String?
  avatarUrl            String?
  githubId             String?          @unique
  githubTokenEncrypted String?
  githubTokenUpdatedAt DateTime?
  stripeCustomerId     String?          @unique
  subscriptionTier     SubscriptionTier @default(FREE)
  repositories         Repository[]
  savedCarts           SavedCart[]
  answerSessions       AnswerSession[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

model Repository {
  id                   String               @id @default(uuid()) @db.Uuid
  userId               String               @db.Uuid
  githubRepoId         String?
  indexFormatVersion   Int                  @default(1)
  name                 String
  fullName             String
  owner                String?
  githubUrl            String
  defaultBranch        String?
  isPrivate            Boolean              @default(true)
  lastScannedAt        DateTime?
  lastIndexedCommitSha String?
  scanStatus           RepositoryScanStatus @default(IDLE)
  scanProgress         Int                  @default(0)
  filesDiscovered      Int                  @default(0)
  filesProcessed       Int                  @default(0)
  errorMessage         String?
  activeScanJobId      String?              @db.Uuid
  codeDocuments        CodeDocument[]
  scanJobs             ScanJob[]
  savedCarts           SavedCart[]
  answerSessions       AnswerSession[]
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([userId, githubUrl])
  @@unique([userId, githubRepoId])
  @@index([userId])
  @@index([userId, scanStatus])
  @@index([userId, githubRepoId])
  @@index([lastScannedAt])
}

model CodeDocument {
  id                  String     @id @default(uuid()) @db.Uuid
  repositoryId        String     @db.Uuid
  lastSeenScanJobId   String?    @db.Uuid
  filePath            String
  chunkIndex          Int        @default(0)
  language            String?
  fileCategory        String?
  chunkType           String?
  pathBucket          String?
  content             String     @db.Text
  contentHash         String
  tokenCount          Int        @default(0)
  embedding           Unsupported("vector(768)")?
  embeddingModel      String?
  embeddingDimensions Int?
  metadata            Json?
  repository          Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@unique([repositoryId, filePath, chunkIndex])
  @@index([repositoryId, filePath])
  @@index([repositoryId, contentHash])
  @@index([repositoryId, language])
  @@index([repositoryId, fileCategory])
  @@index([repositoryId, pathBucket])
  @@index([repositoryId, lastSeenScanJobId])
  @@index([embedding], map: "idx_code_documents_embedding")
}

model ScanJob {
  id                String        @id @default(uuid()) @db.Uuid
  repositoryId      String        @db.Uuid
  triggeredByUserId String        @db.Uuid
  status            ScanJobStatus @default(QUEUED)
  indexedCommitSha  String?
  filesDiscovered   Int           @default(0)
  filesProcessed    Int           @default(0)
  errorMessage      String?
  startedAt         DateTime?
  lastHeartbeatAt   DateTime?
  completedAt       DateTime?
  repository        Repository    @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([repositoryId, createdAt])
  @@index([repositoryId, status])
  @@index([repositoryId, lastHeartbeatAt])
  @@index([triggeredByUserId])
}

model SavedCart {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @db.Uuid
  repositoryId String          @db.Uuid
  title        String
  description  String?
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository   Repository      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  items        SavedCartItem[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId, repositoryId, updatedAt])
  @@index([repositoryId, updatedAt])
}

model SavedCartItem {
  id              String     @id @default(uuid()) @db.Uuid
  savedCartId      String     @db.Uuid
  codeDocumentId   String?    @db.Uuid
  filePath         String
  chunkIndex       Int
  language         String?
  contentSnapshot  String     @db.Text
  score            Float?
  orderIndex       Int
  savedCart        SavedCart  @relation(fields: [savedCartId], references: [id], onDelete: Cascade)
  createdAt        DateTime   @default(now())

  @@index([savedCartId, orderIndex])
  @@index([codeDocumentId])
}

model AnswerSession {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @db.Uuid
  repositoryId String              @db.Uuid
  question     String              @db.Text
  answer       String              @db.Text
  status       AnswerSessionStatus @default(SAVED)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository   Repository          @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  citations    AnswerCitation[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([userId, repositoryId, updatedAt])
  @@index([repositoryId, updatedAt])
}

model AnswerCitation {
  id             String        @id @default(uuid()) @db.Uuid
  answerSessionId String        @db.Uuid
  codeDocumentId  String?       @db.Uuid
  filePath        String
  chunkIndex      Int
  language        String?
  contentSnapshot String        @db.Text
  score           Float?
  orderIndex      Int
  answerSession   AnswerSession @relation(fields: [answerSessionId], references: [id], onDelete: Cascade)

  @@index([answerSessionId, orderIndex])
  @@index([codeDocumentId])
}
